{
    "name": "imovies",
    "version": "0.1.0",
    "private": true,
    "description": "Movie ticket booking made simple.",
    "workspaces": [
        "frontend",
        "backend"
    ],
    "scripts": {
        "install:all": "npm install --workspaces",
        "dev": "concurrently npm:dev:*",
        "build": "npm run build --workspace frontend",
        "test": "npm run test --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "dev:frontend": "npm --prefix frontend run dev",
        "dev:backend": "npm --prefix backend run dev",
        "db:up": "docker compose up -d mongodb",
        "db:down": "docker compose down",
        "seed": "npm run seed --workspace backend",
        "verify": "npm run lint && npm test && npm run build"
    },
    "engines": {
        "node": ">=22.13.0",
        "npm": ">=8"
    },
    "license": "MIT",
    "devDependencies": {
        "concurrently": "^9.0.0"
    },
    "optionalDependencies": {
        "@rolldown/binding-linux-x64-gnu": "1.2.15",
        "lightningcss-linux-x64-gnu": "1.33.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ashvin94/Imovies.git"
    },
    "bugs": {
        "url": "https://github.com/ashvin94/Imovies/issues"
    }
}
