{
  "info": {
    "name": "IMovies API",
    "description": "Local review collection. Keep credentials in the untracked Postman environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "accessToken", "value": "" },
    { "key": "movieId", "value": "" },
    { "key": "showId", "value": "" },
    { "key": "seatId", "value": "" },
    { "key": "bookingId", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [{ "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } }]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.data?.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }
        },
        { "name": "Current Profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/auth/me" } },
        { "name": "Refresh Session", "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh" } },
        { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" } }
      ]
    },
    {
      "name": "Catalogue",
      "item": [
        { "name": "Movies", "request": { "method": "GET", "url": "{{baseUrl}}/movies" } },
        { "name": "Movie Shows", "request": { "method": "GET", "url": "{{baseUrl}}/shows?movieId={{movieId}}" } },
        { "name": "Show Seats", "request": { "method": "GET", "url": "{{baseUrl}}/shows/{{showId}}/seats" } }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        { "name": "Hold Seat", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"showId\": \"{{showId}}\",\n  \"seatIds\": [\"{{seatId}}\"]\n}" }, "url": "{{baseUrl}}/bookings/holds" } },
        { "name": "Confirm Booking", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"paymentResult\": \"success\"\n}" }, "url": "{{baseUrl}}/bookings/{{bookingId}}/confirm" } },
        { "name": "My Bookings", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/bookings" } },
        { "name": "Cancel Booking", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/bookings/{{bookingId}}/cancel" } }
      ]
    },
    {
      "name": "Administration",
      "item": [
        { "name": "Admin Status", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/admin/status" } },
        { "name": "Admin Movies", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/admin/movies" } },
        { "name": "Admin Bookings", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/admin/bookings" } }
      ]
    }
  ]
}
